settings:
  lib_name: nor2b_pex
  units:
    time: ns
    voltage: V
    current: uA
    pulling_resistance: kOhm
    leakage_power: nW
    capacitive_load: pF
    energy: fJ
  voltage: 1.8

includes:
  - sky130A/libs.tech/ngspice/sky130.lib.spice tt
  - cells/nor2b_pex.spice

cells:
  nor2b:
    pins:
      inputs:
        - a
        - b
      outputs:
        - name: y
          function: "(a & !b)"